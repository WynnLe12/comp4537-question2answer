# Supply two public hostnames without a scheme or port.
DEMO_UI_HOST=qa.example.com
DEMO_API_HOST=api.example.com
DEMO_ACME_EMAIL=
# Use independent random values. Hex strings avoid shell and dotenv quoting issues.
DB_PASSWORD=
DB_ROOT_PASSWORD=
AUTH_JWT_SECRET=
BRIDGE_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
Q2A_MILESTONE_DEMO_ACCOUNTS=1
# New users must verify their email before posting; 0 turns it off.
Q2A_CONFIRM_EMAILS=1
# Gmail account and app password that sends the verification emails; empty keeps them in Mailpit.
SMTP_USERNAME=
SMTP_PASSWORD=
