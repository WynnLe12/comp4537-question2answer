# Use sibling names under a domain you control. Supply hostnames without a scheme or port.
DEMO_UI_HOST=qa.example.com
DEMO_API_HOST=api.example.com
# Space-separated public IP addresses or CIDRs of demo attendees.
DEMO_ALLOWED_IPS=
DEMO_ACME_EMAIL=
# Use independent random values. Hex strings avoid shell and dotenv quoting issues.
DB_PASSWORD=
DB_ROOT_PASSWORD=
AUTH_JWT_SECRET=
BRIDGE_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
Q2A_MILESTONE_DEMO_ACCOUNTS=1
