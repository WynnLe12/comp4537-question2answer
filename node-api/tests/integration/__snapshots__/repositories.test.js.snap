      ],
      [
        "INSERT INTO qa_userpoints (userid, qposts, aupvotes, points) VALUES (?, @_qposts:=(SELECT COUNT(*) AS qposts FROM qa_posts AS userid_src WHERE userid=? AND type='Q'), @_aupvotes:=(SELECT COUNT(*) AS aupvotes FROM qa_uservotes AS userid_src JOIN qa_posts ON userid_src.postid=qa_posts.postid WHERE userid_src.userid=? AND LEFT(qa_posts.type, 1)='A' AND userid_src.vote>0), 100+(2*@_qposts)+(1*@_aupvotes)) ON DUPLICATE KEY UPDATE qposts=@_qposts, aupvotes=@_aupvotes, points=100+(2*@_qposts)+(4*aposts)+(0*cposts)+(3*aselects)+(30*aselecteds)+(1*qupvotes)+(1*qdownvotes)+(1*@_aupvotes)+(1*adownvotes)+(0*cupvotes)+(0*cdownvotes)+(1*qvoteds)+(1*avoteds)+(1*cvoteds)+(0*upvoteds)+(0*downvoteds)+bonus",
        [
          7,
          7,
          7,
        ],
      ],
      [
        "INSERT INTO qa_options (title, content) VALUES (?, ?) ON DUPLICATE KEY UPDATE content = VALUES(content) + CAST(content AS UNSIGNED)",
        [
          "cache_userpointscount",
          1,
