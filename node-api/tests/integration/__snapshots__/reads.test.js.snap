vorites.entityid AND qa_userfavorites.userid='6' AND qa_userfavorites.entitytype='Q' LEFT JOIN qa_users ON qa_posts.userid=qa_users.userid LEFT JOIN qa_userpoints ON qa_posts.userid=qa_userpoints.userid JOIN (SELECT entitytype, questionid, lastpostid, updatetype, lastuserid, updated FROM qa_userevents WHERE userid='6' UNION SELECT qa_sharedevents.entitytype, questionid, lastpostid, updatetype, lastuserid, updated FROM qa_sharedevents JOIN qa_userfavorites ON qa_sharedevents.entitytype=qa_userfavorites.entitytype AND qa_sharedevents.entityid=qa_userfavorites.entityid AND qa_userfavorites.nouserevents=1 WHERE userid='6') fullevents ON qa_posts.postid=fullevents.questionid JOIN qa_posts AS updateposts ON updateposts.postid=fullevents.lastpostid AND (updateposts.type IN ('Q', 'A', 'C') OR fullevents.entitytype='-') AND (qa_posts.selchildid=fullevents.lastpostid OR NOT fullevents.updatetype<=>'S') AND qa_posts.type IN ('Q', 'Q_HIDDEN') LEFT JOIN qa_users AS eventusers ON fullevents.lastuserid=eventusers.userid LEFT JOIN qa_userpoints AS eventuserpoints ON fullevents.lastuserid=eventuserpoints.userid",
