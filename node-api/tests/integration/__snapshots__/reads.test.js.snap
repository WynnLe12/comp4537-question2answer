rentposts ON qa_posts.postid=IF(LEFT(parentposts.type, 1)='Q', parentposts.postid, parentposts.parentid) JOIN qa_posts AS editposts ON parentposts.postid=IF(LEFT(editposts.type, 1)='Q', editposts.postid, editposts.parentid) JOIN (SELECT postid FROM qa_posts WHERE  lastuserid=(SELECT userid FROM qa_users WHERE handle='bob' LIMIT 1) AND type IN ('Q', 'A', 'C') ORDER BY updated DESC LIMIT 10) y ON editposts.postid=y.postid  WHERE parentposts.type IN ('Q', 'A', 'C') AND qa_posts.type IN ('Q', 'A', 'C')",
