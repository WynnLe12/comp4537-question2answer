    "SELECT qa_posts.postid, qa_posts.categoryid, qa_posts.type, LEFT(qa_posts.type, 1) AS \`basetype\`, INSTR(qa_posts.type, '_HIDDEN')>0 AS \`hidden\`, INSTR(qa_posts.type, '_QUEUED')>0 AS \`queued\`, qa_posts.acount, qa_posts.amaxvote, qa_posts.selchildid, qa_posts.closedbyid, qa_posts.upvotes, qa_posts.downvotes, qa_posts.netvotes, qa_posts.views, qa_posts.hotness, qa_posts.flagcount, qa_posts.title, qa_posts.tags, UNIX_TIMESTAMP(qa_posts.created) AS \`created\`, qa_posts.name, qa_categories.title AS \`categoryname\`, qa_categories.backpath AS \`categorybackpath\`, CONCAT_WS(',', qa_posts.catidpath1, qa_posts.catidpath2, qa_posts.catidpath3, qa_posts.categoryid) AS \`categoryids\`, qa_uservotes.vote AS \`uservote\`, qa_uservotes.flag AS \`userflag\`, qa_userfavorites.entityid<=>qa_posts.postid AS \`userfavoriteq\`, qa_posts.userid, qa_posts.cookieid, qa_posts.createip AS \`createip\`, qa_userpoints.points, qa_users.flags, qa_users.level, qa_users.email AS \`email\`, qa_users.handle AS \`handle\`, BINARY qa_users.avatarblobid AS \`avatarblobid\`, qa_users.avatarwidth, qa_users.avatarheight, LEFT(updateposts.type, 1) AS \`obasetype\`, fullevents.updatetype AS \`oupdatetype\`, INSTR(updateposts.type, '_HIDDEN')>0 AS \`ohidden\`, fullevents.lastpostid AS \`opostid\`, fullevents.lastuserid AS \`ouserid\`, UNIX_TIMESTAMP(fullevents.updated) AS \`otime\`, fullevents.entitytype='-' AS \`opersonal\`, updateposts.parentid AS \`oparentid\`, eventusers.flags AS \`oflags\`, eventusers.level AS \`olevel\`, eventusers.email AS \`oemail\`, eventusers.handle AS \`ohandle\`, BINARY eventusers.avatarblobid AS \`oavatarblobid\`, eventusers.avatarwidth AS \`oavatarwidth\`, eventusers.avatarheight AS \`oavatarheight\`, eventuserpoints.points AS \`opoints\` FROM qa_posts LEFT JOIN qa_categories ON qa_categories.categoryid=qa_posts.categoryid LEFT JOIN qa_uservotes ON qa_posts.postid=qa_uservotes.postid AND qa_uservotes.userid='6' LEFT JOIN qa_userfavorites ON qa_posts.postid=qa_userfavorites.entityid AND qa_userfavorites.userid='6' AND qa_userfavorites.entitytype='Q' LEFT JOIN qa_users ON qa_posts.userid=qa_users.userid LEFT JOIN qa_userpoints ON qa_posts.userid=qa_userpoints.userid JOIN (SELECT entitytype, questionid, lastpostid, updatetype, lastuserid, updated FROM qa_userevents WHERE userid='6' AND entitytype!='-' UNION SELECT qa_sharedevents.entitytype, questionid, lastpostid, updatetype, lastuserid, updated FROM qa_sharedevents JOIN qa_userfavorites ON qa_sharedevents.entitytype=qa_userfavorites.entitytype AND qa_sharedevents.entityid=qa_userfavorites.entityid AND qa_userfavorites.nouserevents=1 WHERE userid='6') fullevents ON qa_posts.postid=fullevents.questionid JOIN qa_posts AS updateposts ON updateposts.postid=fullevents.lastpostid AND (updateposts.type IN ('Q', 'A', 'C') OR fullevents.entitytype='-') AND (qa_posts.selchildid=fullevents.lastpostid OR NOT fullevents.updatetype<=>'S') AND qa_posts.type IN ('Q', 'Q_HIDDEN') LEFT JOIN qa_users AS eventusers ON fullevents.lastuserid=eventusers.userid LEFT JOIN qa_userpoints AS eventuserpoints ON fullevents.lastuserid=eventuserpoints.userid",
  ],
  "status": 200,
}
`;

