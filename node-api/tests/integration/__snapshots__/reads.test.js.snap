tid=qa_uservotes.postid AND qa_uservotes.userid='5' LEFT JOIN qa_userfavorites ON qa_posts.postid=qa_userfavorites.entityid AND qa_userfavorites.userid='5' AND qa_userfavorites.entitytype='Q' LEFT JOIN qa_users ON qa_posts.userid=qa_users.userid LEFT JOIN qa_userpoints ON qa_posts.userid=qa_userpoints.userid JOIN qa_posts AS parentposts ON qa_posts.postid=IF(LEFT(parentposts.type, 1)='Q', parentposts.postid, parentposts.parentid) JOIN qa_posts AS flagposts ON parentposts.postid=IF(LEFT(flagposts.type, 1)='Q', flagposts.postid, flagposts.parentid) LEFT JOIN qa_users AS flagusers ON flagposts.userid=flagusers.userid LEFT JOIN qa_userpoints AS flaguserpoints ON flagposts.userid=flaguserpoints.userid JOIN (SELECT postid FROM qa_posts WHERE flagcount>0 AND type IN ('Q', 'A', 'C') ORDER BY qa_posts.flagcount DESC, qa_posts.created DESC LIMIT 0,20) y ON flagposts.postid=y.postid",
