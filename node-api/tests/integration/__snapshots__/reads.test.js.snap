stid=aposts.parentid JOIN (SELECT postid FROM qa_posts WHERE  userid=(SELECT userid FROM qa_users WHERE handle='bob' LIMIT 1) AND type='A' ORDER BY created DESC LIMIT 0,10) y ON aposts.postid=y.postid WHERE qa_posts.type='Q'",
