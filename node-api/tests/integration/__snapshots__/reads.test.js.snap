qa_posts AS cposts ON parentposts.postid=cposts.parentid JOIN (SELECT postid FROM qa_posts WHERE  userid=(SELECT userid FROM qa_users WHERE handle='bob' LIMIT 1) AND type='C' ORDER BY created DESC LIMIT 10) y ON cposts.postid=y.postid WHERE qa_posts.type='Q' AND parentposts.type IN ('Q', 'A')",
