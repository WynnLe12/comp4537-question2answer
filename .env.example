# Local demo only. Generate a private secret for your .env with:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
AUTH_JWT_SECRET=local-only-q2a-jwt-signing-secret-change-for-production
# Bcrypt work factor (integer from 4 to 31); 10 preserves the demo default.
BCRYPT_SALT_ROUNDS=10
# Shared by the PHP bridge and the Node API for the bridge-only page reads; generate one like the JWT secret.
BRIDGE_SECRET=local-only-q2a-bridge-secret-change-for-production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Allowed frontend origins for browser API requests
CLIENT_ORIGINS=http://localhost:8081
# Enable the short-password Milestone 1 fixtures only in an isolated demo.
Q2A_MILESTONE_DEMO_ACCOUNTS=0
# New users must click a link in their welcome email before they can post (1 = on, 0 = off).
# Set it to 0, and SMTP_USERNAME empty, before running the parity tests, which register and post at once.
Q2A_CONFIRM_EMAILS=1
# Send email for real through a Gmail account (needs 2-Step Verification and an app password from
# https://myaccount.google.com/apppasswords). Leave SMTP_USERNAME empty to catch everything in Mailpit.
SMTP_USERNAME=
SMTP_PASSWORD=
