# Local demo only. Generate a private secret for your .env with:
# node -p "require('node:crypto').randomBytes(32).toString('hex')"
AUTH_JWT_SECRET=local-only-q2a-jwt-signing-secret-change-for-production
# Bcrypt work factor (integer from 4 to 31); 10 preserves the demo default.
BCRYPT_SALT_ROUNDS=10
